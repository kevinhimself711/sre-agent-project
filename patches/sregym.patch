new file mode 100644
index 0000000..d5c360d
--- /dev/null
+++ b/sregym/traces/holmes_export.py
@@ -0,0 +1,169 @@
+"""Strict host-side acceptance and SFT-format export; official scores stay untouched."""
+
+from __future__ import annotations
+
+import argparse
+import ast
+import csv
+import hashlib
+import json
+from pathlib import Path
+
+from atif_converter.adapters.holmes import convert_file
+
+DEVELOPMENT_CASES = {"network_policy_block", "wrong_service_selector_social_network"}
+VALIDATION_CASES = {"namespace_memory_limit", "readiness_probe_misconfiguration_social_network"}
+
+
+def _decode(value):
+    try:
+        return json.loads(value)
+    except (TypeError, ValueError):
+        try:
+            return ast.literal_eval(value)
+        except (TypeError, ValueError, SyntaxError):
+            return value
+
+
+def check_prompt(messages):
+    pending = set()
+    for message in messages:
+        if message.get("role") == "assistant":
+            pending.update(call["id"] for call in message.get("tool_calls") or [])
+        if message.get("role") == "tool":
+            call_id = message.get("tool_call_id")
+            if call_id not in pending:
+                raise ValueError("Tool result without an earlier matching call")
+            pending.remove(call_id)
+    if pending:
+        raise ValueError("Model input has unanswered tool calls")
+
+
+def export_run(run_dir: Path):
+    raw_path = run_dir / "holmes.events.jsonl"
+    trajectory = convert_file(raw_path)
+    issues = list(trajectory.extra["holmes"]["capture_issues"])
+    case = run_dir.parent.name
+    csv_path = run_dir / f"{case}_results.csv"
+    if not csv_path.is_file():
+        issues.append("missing_official_result")
+        row = {}
+    else:
+        with csv_path.open(encoding="utf-8") as handle:
+            rows = list(csv.DictReader(handle))
+        if len(rows) != 1:
+            issues.append("invalid_official_result_count")
+        row = rows[0] if rows else {}
+    diagnosis = _decode(row.get("Diagnosis", ""))
+    diagnosis = diagnosis if isinstance(diagnosis, dict) else {}
+    # Current upstream flattens nested results into Diagnosis.* CSV columns.
+    # Retain compatibility with earlier exports containing one Diagnosis cell.
+    for key in ("success", "composite_score"):
+        if "Diagnosis." + key in row:
+            diagnosis[key] = _decode(row["Diagnosis." + key])
+    complete = row.get("run_status") == "complete"
+    cleanup_failed = str(row.get("cleanup_failed", "")).lower() in ("true", "1")
+    if not complete:
+        issues.append("official_run_incomplete")
+    if cleanup_failed:
+        issues.append("cleanup_failed")
+    split = "dev" if case in DEVELOPMENT_CASES else "validation" if case in VALIDATION_CASES else "unassigned"
+    positive = diagnosis.get("success") is True and complete and not issues and split == "dev"
+    samples = []
+    events = [json.loads(line) for line in raw_path.read_text(encoding="utf-8").splitlines() if line.strip()]
+    requests = {event["request_id"]: event for event in events if event["event"] == "model_request"}
+    # A pre-review draft is retained as context, never a positive supervision target.
+    drafts = {event.get("draft_request_id") for event in events if event["event"] == "diagnosis_review" and event.get("state") == "triggered"}
+    for event in events:
+        if event["event"] != "model_response":
+            continue
+        if event["request_id"] in drafts:
+            continue
+        request_event = requests[event["request_id"]]
+        if request_event.get("purpose") != "investigation":
+            continue
+        request = request_event["request"]
+        try:
+            check_prompt(request["messages"])
+        except ValueError as exc:
+            issues.append(str(exc))
+            continue
+        choice = event["response"]["choices"][0]
+        if choice.get("finish_reason") not in ("stop", "tool_calls"):
+            continue
+        assistant = {
+            k: v for k, v in choice["message"].items() if k in ("role", "content", "tool_calls") and v is not None
+        }
+        assistant["role"] = "assistant"
+        messages = request["messages"] + [assistant]
+        if positive:
+            samples.append(
+                {
+                    "schema_version": 1,
+                    "messages": messages,
+                    "tools": request.get("tools", []),
+                    "loss_mask_messages": [0] * (len(messages) - 1) + [1],
+                    "provenance": {
+                        "session_id": trajectory.session_id,
+                        "request_id": event["request_id"],
+                        "case": case,
+                        "split": split,
+                        "raw_sha256": trajectory.extra["holmes"]["raw_sha256"],
+                        "teacher": trajectory.agent.model_name,
+                        "purpose": "format-validation-only",
+                        "tokenizer": None,
+                        "chat_template": None,
+                    },
+                }
+            )
+    if issues:
+        samples = []
+    acceptance = {
+        "schema_version": 1,
+        "case": case,
+        "capture_complete": trajectory.extra["holmes"]["capture_complete"],
+        "official_run_complete": complete,
+        "diagnosis_success": diagnosis.get("success"),
+        "composite_score": diagnosis.get("composite_score"),
+        "issues": issues,
+        "sft_samples": len(samples),
+        "split": split,
+    }
+    (run_dir / "data-acceptance.json").write_text(
+        json.dumps(acceptance, indent=2, ensure_ascii=False) + "\n", encoding="utf-8"
+    )
+    (run_dir / "sft-format-samples.jsonl").write_text(
+        "".join(json.dumps(x, ensure_ascii=False) + "\n" for x in samples), encoding="utf-8"
+    )
+    files = {}
+    for path in sorted(run_dir.rglob("*")):
+        if path.is_file() and not path.is_symlink() and path.name != "artifact-manifest.json":
+            files[path.relative_to(run_dir).as_posix()] = hashlib.sha256(path.read_bytes()).hexdigest()
+    (run_dir / "artifact-manifest.json").write_text(
+        json.dumps({"schema_version": 1, "sha256": files}, indent=2) + "\n", encoding="utf-8"
+    )
+    return acceptance
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("path", type=Path)
+    args = parser.parse_args()
+    files = (
+        [args.path / "holmes.events.jsonl"]
+        if (args.path / "holmes.events.jsonl").is_file()
+        else sorted(args.path.rglob("holmes.events.jsonl"))
+    )
+    failed = not files
+    for file in files:
+        try:
+            result = export_run(file.parent)
+        except Exception as exc:
+            result = {"path": str(file.parent), "issues": [f"{type(exc).__name__}: {exc}"]}
+        print(json.dumps(result, ensure_ascii=False))
+        failed |= bool(result["issues"])
+    raise SystemExit(1 if failed else 0)
+
+
+if __name__ == "__main__":
+    main()
