@@ -0,0 +1,222 @@
+import csv
+import json
+from unittest.mock import Mock
+
+import pytest
+import requests
+
+from atif_converter import convert, detect_agent
+from clients.holmes.driver import submit_once
+from sregym.traces import store
+from sregym.traces.holmes_export import export_run
+
+
+def write_episode(tmp_path, *, omit_tool=False):
+    timestamp = "2026-09-19T00:00:00+00:00"
+    events = [
+        {"event": "episode_start", "agent": "holmes", "session_id": "test-1", "agent_version": "test", "model": "test"},
+        {
+            "event": "model_request",
+            "request_id": "a",
+            "purpose": "investigation",
+            "request": {"messages": [{"role": "user", "content": "diagnose"}], "tools": []},
+        },
+        {
+            "event": "model_response",
+            "request_id": "a",
+            "response": {
+                "model": "test",
+                "usage": {"prompt_tokens": 10, "completion_tokens": 5},
+                "choices": [
+                    {
+                        "message": {
+                            "content": "",
+                            "tool_calls": [{"id": "c1", "function": {"name": "query", "arguments": "{}"}}],
+                        },
+                        "finish_reason": "tool_calls",
+                    }
+                ],
+            },
+        },
+    ]
+    if not omit_tool:
+        events.append(
+            {"event": "tool_end", "result": {"tool_call_id": "c1", "result": {"status": "error", "error": "timeout"}}}
+        )
+    events.extend(
+        [
+            {
+                "event": "model_request",
+                "request_id": "b",
+                "purpose": "investigation",
+                "request": {"messages": [{"role": "system", "content": "compressed: query timed out"}], "tools": []},
+            },
+            {
+                "event": "model_response",
+                "request_id": "b",
+                "response": {
+                    "model": "test",
+                    "usage": {"prompt_tokens": 4, "completion_tokens": 3},
+                    "choices": [{"message": {"content": "insufficient evidence"}, "finish_reason": "stop"}],
+                },
+            },
+            {"event": "artifact_manifest", "attachments": []},
+            {"event": "episode_end", "state": "finished"},
+        ]
+    )
+    path = tmp_path / "holmes.events.jsonl"
+    path.write_text(
+        "\n".join(json.dumps({"schema_version": 1, "timestamp": timestamp, **event}) for event in events),
+        encoding="utf-8",
+    )
+    return path
+
+
+def test_conversion_preserves_error_and_effective_context(tmp_path):
+    path = write_episode(tmp_path)
+    assert detect_agent(path) == "holmes"
+    trajectory = convert(path)
+    assert trajectory.extra["holmes"]["capture_complete"]
+    assert "timeout" in trajectory.steps[1].observation.results[0].content
+    assert trajectory.steps[2].extra["effective_request"]["messages"] == [
+        {"role": "system", "content": "compressed: query timed out"}
+    ]
+    assert trajectory.final_metrics.total_prompt_tokens == 14
+
+
+def test_missing_tool_result_marks_incomplete(tmp_path):
+    trajectory = convert(write_episode(tmp_path, omit_tool=True))
+    assert not trajectory.extra["holmes"]["capture_complete"]
+    assert "missing_tool_result:c1" in trajectory.extra["holmes"]["capture_issues"]
+
+
+def test_missing_attachment_is_not_complete(tmp_path):
+    path = write_episode(tmp_path)
+    events = [json.loads(line) for line in path.read_text().splitlines()]
+    next(e for e in events if e["event"] == "artifact_manifest")["attachments"] = [
+        {"path": "tool-results/missing.txt", "sha256": "0" * 64, "size_bytes": 1}
+    ]
+    path.write_text("\n".join(json.dumps(e) for e in events))
+    trajectory = convert(path)
+    assert not trajectory.extra["holmes"]["capture_complete"]
+    assert "missing_or_unsafe_attachment:tool-results/missing.txt" in trajectory.extra["holmes"]["capture_issues"]
+
+
+def test_repeated_ingestion_deduplicates(tmp_path):
+    trajectory = convert(write_episode(tmp_path))
+    path = tmp_path / "trajectory.json"
+    path.write_text(json.dumps(trajectory.to_json_dict()), encoding="utf-8")
+    db = tmp_path / "traces.db"
+    store.ingest_trajectory_file(path, db)
+    store.ingest_trajectory_file(path, db)
+    with store.connect(db) as conn:
+        assert conn.execute("SELECT count(*) FROM trajectories").fetchone()[0] == 1
+
+
+def test_ambiguous_submission_is_not_retried():
+    session = Mock()
+    session.post.side_effect = requests.Timeout()
+    session.get.return_value.json.return_value = {"stage": "done"}
+    assert submit_once("http://conductor", "diagnosis", session)["state"] == "unknown"
+    session.post.assert_called_once()
+
+
+def test_submission_http_error_is_not_acknowledgment():
+    session = Mock()
+    session.post.return_value.raise_for_status.side_effect = requests.HTTPError("409")
+    with pytest.raises(requests.HTTPError):
+        submit_once("http://conductor", "diagnosis", session)
+    session.post.assert_called_once()
+
+
+@pytest.mark.parametrize("success,expected", [(True, 2), (False, 0)])
+def test_sft_export_requires_official_success_and_is_repeatable(tmp_path, success, expected):
+    run = tmp_path / "network_policy_block" / "run_1"
+    run.mkdir(parents=True)
+    write_episode(run)
+    with (run / "network_policy_block_results.csv").open("w", newline="", encoding="utf-8") as handle:
+        writer = csv.DictWriter(handle, fieldnames=["run_status", "Diagnosis"])
+        writer.writeheader()
+        writer.writerow(
+            {"run_status": "complete", "Diagnosis": repr({"success": success, "composite_score": 1 if success else 0})}
+        )
+    assert export_run(run)["sft_samples"] == expected
+    before = (run / "sft-format-samples.jsonl").read_bytes()
+    export_run(run)
+    assert (run / "sft-format-samples.jsonl").read_bytes() == before
+    if expected:
+        sample = json.loads(before.splitlines()[-1])
+        assert sample["messages"][0]["content"] == "compressed: query timed out"
+        assert sample["loss_mask_messages"] == [0, 1]
+
+
+def test_admin_config_does_not_fall_back_to_agent_config(monkeypatch, tmp_path):
+    from sregym.service import k8s_proxy
+
+    admin = str(tmp_path / "admin.yaml")
+    monkeypatch.setenv("SREGYM_ADMIN_KUBECONFIG", admin)
+    monkeypatch.setenv("KUBECONFIG", str(tmp_path / "filtered-agent.yaml"))
+    monkeypatch.setattr(k8s_proxy.KubernetesAPIProxy, "_INCLUSTER_TOKEN_PATH", str(tmp_path / "no-token"))
+    load = Mock()
+    monkeypatch.setattr(k8s_proxy.config, "load_kube_config", load)
+    extraction = Mock(return_value=("localhost", 6443, "ca", "cert", "key"))
+    monkeypatch.setattr(k8s_proxy.KubernetesAPIProxy, "_load_cluster_config", extraction)
+    k8s_proxy.KubernetesAPIProxy()
+    load.assert_called_once_with(config_file=admin)
+    extraction.assert_called_once_with(kubeconfig_path=admin)
+
+
+def test_sft_reads_current_flattened_official_csv(tmp_path):
+    run = tmp_path / "network_policy_block" / "run_1"
+    run.mkdir(parents=True)
+    write_episode(run)
+    (run / "network_policy_block_results.csv").write_text(
+        "run_status,Diagnosis.success,Diagnosis.composite_score\ncomplete,True,1.0\n", encoding="utf-8"
+    )
+    result = export_run(run)
+    assert result["diagnosis_success"] is True
+    assert result["composite_score"] == 1.0
+    assert result["sft_samples"] == 2
+
+
+def test_acknowledged_driver_submission_is_indexed(tmp_path):
+    from sregym.traces.convert import convert_run
+
+    run = tmp_path / "batch" / "holmes" / "network_policy_block" / "run_1"
+    run.mkdir(parents=True)
+    path = write_episode(run)
+    events = [json.loads(line) for line in path.read_text().splitlines()]
+    events.insert(
+        -1,
+        {
+            "event": "submission",
+            "state": "acknowledged",
+            "timestamp": events[0]["timestamp"],
+            "response": {"status": "200", "message": "Submission received"},
+        },
+    )
+    path.write_text("\n".join(json.dumps(e) for e in events))
+    assert convert_run(run).extra["sregym"]["submitted"] is True
+
+
+@pytest.mark.parametrize("case", ["namespace_memory_limit", "readiness_probe_misconfiguration_social_network", "unknown_case"])
+def test_non_development_cases_never_export_positive_samples(tmp_path, case):
+    run = tmp_path / case / "run_1"
+    run.mkdir(parents=True)
+    write_episode(run)
+    (run / f"{case}_results.csv").write_text("run_status,Diagnosis.success,Diagnosis.composite_score\ncomplete,True,1.0\n")
+    assert export_run(run)["sft_samples"] == 0
+    assert (run / "sft-format-samples.jsonl").read_bytes() == b""
+
+
+def test_reviewed_draft_is_not_a_supervision_target(tmp_path):
+    run = tmp_path / "network_policy_block" / "run_1"
+    run.mkdir(parents=True)
+    path = write_episode(run)
+    events = [json.loads(line) for line in path.read_text().splitlines()]
+    events.insert(-1, {"event": "diagnosis_review", "state": "triggered", "draft_request_id": "b", "timestamp": events[0]["timestamp"]})
+    path.write_text("\n".join(json.dumps(e) for e in events))
+    (run / "network_policy_block_results.csv").write_text("run_status,Diagnosis.success,Diagnosis.composite_score\ncomplete,True,1.0\n")
+    assert export_run(run)["sft_samples"] == 1
+    samples = [json.loads(line) for line in (run / "sft-format-samples.jsonl").read_text().splitlines()]
+    assert all(s["provenance"]["request_id"] != "b" for s in samples)
