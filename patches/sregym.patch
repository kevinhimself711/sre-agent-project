diff --git a/clients/holmes/driver.py b/clients/holmes/driver.py
new file mode 100644
index 0000000..80b4916
--- /dev/null
+++ b/clients/holmes/driver.py
@@ -0,0 +1,234 @@
+"""Use Holmes' native prompt and loop with only the benchmark's MCP tools."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import time
+import uuid
+from pathlib import Path
+
+import requests
+
+VARIANTS = {"baseline", "review", "recovery", "combined"}
+
+
+def harness_variant():
+    variant = os.environ.get("HOLMES_HARNESS", "baseline")
+    if variant not in VARIANTS:
+        raise ValueError(f"Unknown harness variant: {variant}")
+    return variant
+
+
+def recovery_rules():
+    return [
+        {"prefix": "Command Rejected", "contains": "Pipe commands are forbidden", "category": "pipeline_rejected",
+         "recovery_hint": "Use one allowed kubectl command without shell pipes; use native output, label or field filters where applicable. Do not retry the same rejected command."},
+        {"prefix": "Command Rejected", "contains": "forbidden", "category": "permission_denied",
+         "recovery_hint": "Access was denied. Query individually permitted resource types instead of broad get-all queries; do not request elevated credentials or repeat the denied request."},
+        {"prefix": "Command Rejected", "category": "command_rejected",
+         "recovery_hint": "The command did not execute successfully. Inspect the original rejection and choose an allowed read-only query. Do not treat this as evidence that the application resource is faulty."},
+    ]
+
+
+def wait_for_diagnosis(base: str, session=requests, timeout: float = 300):
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        response = session.get(base + "/status", timeout=10)
+        response.raise_for_status()
+        stage = response.json()["stage"]
+        if stage == "diagnosis":
+            return
+        if stage in ("mitigation", "done", "tearing_down"):
+            raise RuntimeError(f"Diagnosis is unavailable: {stage}")
+        time.sleep(1)
+    raise TimeoutError("Conductor did not reach diagnosis")
+
+
+def submit_once(base: str, answer: str, session=requests):
+    """Never retry an ambiguous POST: status is advisory, official artifacts decide."""
+    try:
+        response = session.post(base + "/submit", json={"solution": answer, "stage": "diagnosis"}, timeout=180)
+        response.raise_for_status()
+        payload = response.json()
+        if str(payload.get("status")) != "200":
+            raise RuntimeError("Conductor did not acknowledge diagnosis")
+        return {"state": "acknowledged", "response": payload}
+    except (requests.Timeout, requests.ConnectionError):
+        stage = None
+        try:
+            response = session.get(base + "/status", timeout=10)
+            response.raise_for_status()
+            stage = response.json().get("stage")
+        except requests.RequestException:
+            pass
+        return {"state": "unknown", "observed_stage": stage, "retry_performed": False}
+
+
+def create_config(session_id: str):
+    from holmes.config import Config
+    from holmes.plugins.toolsets import load_builtin_toolsets
+
+    base = os.environ.get("MCP_SERVER_URL") or (
+        f"http://{os.environ.get('API_HOSTNAME', 'localhost')}:{os.environ.get('MCP_SERVER_PORT', '9954')}"
+    )
+    # Several built-ins are enabled by their class defaults even when
+    # enable_all_toolsets_possible=False. Explicitly disable the entire catalog.
+    toolsets = {toolset.name: {"enabled": False} for toolset in load_builtin_toolsets()}
+    toolsets.update(
+        {
+            "sregym_" + name: {
+                "enabled": True,
+                "type": "mcp",
+                "description": f"SREGym {name} tools",
+                "config": {
+                    "mode": "sse",
+                    "url": base.rstrip("/") + "/" + name + "/sse",
+                    "headers": {"sregym_ssid": session_id},
+                },
+            }
+            for name in ("kubectl", "prometheus", "loki", "jaeger")
+        }
+    )
+    if harness_variant() in {"recovery", "combined"}:
+        toolsets["sregym_kubectl"]["config"]["content_error_rules"] = recovery_rules()
+    return Config(
+        model=os.environ["AGENT_MODEL_ID"],
+        api_key=os.environ.get("AGENT_API_KEY"),
+        api_base=os.environ.get("AGENT_API_BASE"),
+        max_steps=int(os.environ.get("HOLMES_MAX_STEPS", "30")),
+        toolsets=toolsets,
+    )
+
+
+def run_preflight():
+    from holmes.core.llm import DefaultLLM
+
+    llm = DefaultLLM(
+        model=os.environ["AGENT_MODEL_ID"],
+        api_key=os.environ.get("AGENT_API_KEY"),
+        api_base=os.environ.get("AGENT_API_BASE"),
+        args={"extra_body": {"enable_thinking": False}, "max_tokens": 512},
+    )
+    response = llm.completion(messages=[{"role": "user", "content": "Reply with ok."}])
+    if not response.choices[0].message.content:
+        raise RuntimeError("Holmes model preflight returned no content")
+    print("Holmes model preflight passed")
+
+
+def create_agent(session_id: str, tool_results_dir: Path | None = None):
+    from holmes.core.toolset_manager import PrerequisiteCacheMode
+
+    agent = create_config(session_id).create_toolcalling_llm(
+        enable_all_toolsets_possible=False,
+        prerequisite_cache=PrerequisiteCacheMode.DISABLED,
+        tool_results_dir=tool_results_dir,
+    )
+    agent.llm.args.update(extra_body={"enable_thinking": False}, max_tokens=8192)
+    agent.diagnosis_review = harness_variant() in {"review", "combined"}
+    enabled = {ts.name for ts in agent.tool_executor.enabled_toolsets}
+    if enabled != {"sregym_" + name for name in ("kubectl", "prometheus", "loki", "jaeger")}:
+        raise RuntimeError(f"Unexpected enabled toolsets: {sorted(enabled)}")
+    return agent
+
+
+def run():
+    os.environ.setdefault("OVERRIDE_MAX_OUTPUT_TOKEN", "8192")
+    os.environ.setdefault("LLM_REQUEST_TIMEOUT", "120")
+    from holmes.core.episode_trace import trace_event
+    from holmes.core.prompt import build_initial_ask_messages
+
+    logs = Path(os.environ.get("AGENT_LOGS_DIR", "/logs"))
+    logs.mkdir(parents=True, exist_ok=True)
+    trace_path = logs / "holmes.events.jsonl"
+    # One process per attempt. Appending to an old episode would corrupt provenance.
+    if trace_path.exists():
+        raise FileExistsError(f"Refusing to mix episodes in {trace_path.name}")
+    os.environ["HOLMES_EPISODE_TRACE"] = str(trace_path)
+    session_id = uuid.uuid4().hex
+    base = f"http://{os.environ.get('API_HOSTNAME', 'localhost')}:{os.environ.get('API_PORT', '8000')}"
+    trace_event(
+        "episode_start",
+        session_id=session_id,
+        agent="holmes",
+        agent_version=os.environ.get("HOLMES_SOURCE_REV", "3bd44edf04f9587c778ee8e9b244965190c40fdf+local"),
+        model=os.environ["AGENT_MODEL_ID"],
+        max_steps=int(os.environ.get("HOLMES_MAX_STEPS", "30")),
+        harness_variant=harness_variant(),
+    )
+
+    def record_attachments():
+        attachments = []
+        for path in sorted((logs / "tool-results").rglob("*")):
+            if path.is_file():
+                attachments.append(
+                    {
+                        "path": path.relative_to(logs).as_posix(),
+                        "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
+                        "size_bytes": path.stat().st_size,
+                    }
+                )
+        trace_event("artifact_manifest", attachments=attachments)
+
+    try:
+        wait_for_diagnosis(base)
+        response = requests.get(base + "/get_app", timeout=15)
+        response.raise_for_status()
+        app = response.json()
+        # Do not read or interpolate the problem ID, root cause or grader data.
+        prompt = (
+            "Diagnose the fault in this Kubernetes application. Investigate autonomously using the available tools. "
+            "Do not mitigate or modify application resources. Finish with a natural-language diagnosis of the "
+            "faulty component and root cause; the driver will submit your final answer.\n"
+            f"Application: {app.get('app_name', '')}\n"
+            f"Namespaces: {', '.join(app.get('namespaces') or [app.get('namespace', 'default')])}\n"
+            f"{app.get('descriptions', '')}"
+        )
+        agent = create_agent(session_id, logs / "tool-results")
+        enabled = [ts.name for ts in agent.tool_executor.enabled_toolsets]
+        trace_event("tool_catalog", toolsets=enabled)
+        messages = build_initial_ask_messages(prompt, None, agent.tool_executor)
+        result = agent.call(messages)
+        if not result.result or not result.result.strip():
+            raise RuntimeError("Holmes returned an empty diagnosis")
+        trace_event(
+            "agent_final", answer=result.result, finish_reason=result.finish_reason, num_llm_calls=result.num_llm_calls
+        )
+        submission = submit_once(base, result.result)
+        trace_event("submission", **submission)
+        record_attachments()
+        trace_event("episode_end", state="finished", submission_state=submission["state"])
+        (logs / "holmes-summary.json").write_text(
+            json.dumps(
+                {
+                    "session_id": session_id,
+                    "answer": result.result,
+                    "submission": submission,
+                    "finish_reason": result.finish_reason,
+                    "num_llm_calls": result.num_llm_calls,
+                },
+                ensure_ascii=False,
+                indent=2,
+            ),
+            encoding="utf-8",
+        )
+    except BaseException as exc:
+        record_attachments()
+        trace_event("episode_end", state="error", error_type=type(exc).__name__)
+        raise
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--preflight", action="store_true")
+    args = parser.parse_args()
+    if args.preflight:
+        run_preflight()
+    else:
+        run()
+
+
+if __name__ == "__main__":
+    main()
