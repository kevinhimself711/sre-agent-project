index 0000000..6d3c769
--- /dev/null
+++ b/atif_converter/adapters/holmes.py
@@ -0,0 +1,181 @@
+"""Convert opt-in Holmes events; preserve effective inputs per inference."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+
+from ..atif import Agent, FinalMetrics, Metrics, Observation, ObservationResult, Step, ToolCall, Trajectory
+
+
+def convert_file(path: Path | str) -> Trajectory:
+    path = Path(path)
+    raw = path.read_bytes()
+    events = [json.loads(line) for line in raw.decode("utf-8").splitlines() if line.strip()]
+    starts = [e for e in events if e.get("event") == "episode_start"]
+    if len(starts) != 1:
+        raise ValueError("Expected exactly one episode_start")
+    start = starts[0]
+    requests, outcomes, tool_steps, tool_results = {}, set(), {}, set()
+    steps, issues = [], []
+    tools = []
+    final_answer = ""
+    episode_end = None
+    attachments = None
+    for event in events:
+        kind = event["event"]
+        if kind == "model_request":
+            request_id = event["request_id"]
+            if request_id in requests:
+                raise ValueError("Duplicate model request ID")
+            requests[request_id] = event
+            request = event["request"]
+            if not steps:
+                for message in request.get("messages", []):
+                    if message["role"] in ("system", "user"):
+                        steps.append(
+                            Step(
+                                step_id=len(steps) + 1,
+                                source=message["role"],
+                                message=message.get("content") or "",
+                                timestamp=event["timestamp"],
+                            )
+                        )
+                tools = request.get("tools") or []
+        elif kind == "model_response":
+            request_id = event["request_id"]
+            if request_id not in requests or request_id in outcomes:
+                raise ValueError("Missing or duplicate model request/response pairing")
+            outcomes.add(request_id)
+            request = requests[request_id]
+            response = event["response"]
+            choice = response["choices"][0]
+            message = choice["message"]
+            usage = response.get("usage") or {}
+            calls = [
+                ToolCall(
+                    tool_call_id=call["id"],
+                    function_name=call["function"]["name"],
+                    arguments=json.loads(call["function"]["arguments"]),
+                )
+                for call in message.get("tool_calls") or []
+            ]
+            step = Step(
+                step_id=len(steps) + 1,
+                source="agent",
+                message=message.get("content") or "",
+                timestamp=event["timestamp"],
+                model_name=response.get("model") or start["model"],
+                tool_calls=calls or None,
+                llm_call_count=1,
+                metrics=Metrics(
+                    prompt_tokens=usage.get("prompt_tokens"),
+                    completion_tokens=usage.get("completion_tokens"),
+                    cached_tokens=(usage.get("prompt_tokens_details") or {}).get("cached_tokens"),
+                    extra={"elapsed_seconds": event.get("elapsed_seconds")},
+                ),
+                extra={
+                    "request_id": request_id,
+                    "purpose": request.get("purpose", "investigation"),
+                    "effective_request": request["request"],
+                    "finish_reason": choice.get("finish_reason"),
+                },
+            )
+            steps.append(step)
+            for call in calls:
+                if call.tool_call_id in tool_steps:
+                    raise ValueError("Duplicate tool call ID")
+                tool_steps[call.tool_call_id] = step
+        elif kind == "tool_end":
+            result = event["result"]
+            call_id = result["tool_call_id"]
+            if call_id not in tool_steps or call_id in tool_results:
+                raise ValueError("Missing or duplicate tool call/result pairing")
+            tool_results.add(call_id)
+            step = tool_steps[call_id]
+            if step.observation is None:
+                step.observation = Observation(results=[])
+            step.observation.results.append(
+                ObservationResult(
+                    source_call_id=call_id,
+                    content=json.dumps(result["result"], ensure_ascii=False),
+                    extra={"elapsed_seconds": event.get("elapsed_seconds")},
+                )
+            )
+        elif kind in ("model_error", "model_capture_incomplete"):
+            outcomes.add(event["request_id"])
+            issues.append(kind + ":" + event["request_id"])
+        elif kind == "agent_final":
+            final_answer = event.get("answer", "")
+        elif kind == "submission":
+            call_id = "driver-submit"
+            steps.append(
+                Step(
+                    step_id=len(steps) + 1,
+                    source="agent",
+                    message="",
+                    llm_call_count=0,
+                    timestamp=event["timestamp"],
+                    tool_calls=[
+                        ToolCall(
+                            tool_call_id=call_id,
+                            function_name="submit",
+                            arguments={"solution": final_answer, "stage": "diagnosis"},
+                        )
+                    ],
+                    observation=Observation(
+                        results=[
+                            ObservationResult(
+                                source_call_id=call_id,
+                                content=json.dumps(event.get("response") or event, ensure_ascii=False),
+                            )
+                        ]
+                    ),
+                )
+            )
+        elif kind == "episode_end":
+            episode_end = event
+        elif kind == "artifact_manifest":
+            attachments = event.get("attachments", [])
+    for request_id in sorted(requests.keys() - outcomes):
+        issues.append("missing_model_outcome:" + request_id)
+    for call_id in sorted(tool_steps.keys() - tool_results):
+        issues.append("missing_tool_result:" + call_id)
+    if not episode_end:
+        issues.append("missing_episode_end")
+    elif episode_end.get("state") != "finished":
+        issues.append("episode_failed")
+    if attachments is None:
+        issues.append("missing_artifact_manifest")
+    for attachment in attachments or []:
+        target = (path.parent / attachment["path"]).resolve()
+        if not target.is_relative_to(path.parent.resolve()) or not target.is_file():
+            issues.append("missing_or_unsafe_attachment:" + attachment["path"])
+        elif hashlib.sha256(target.read_bytes()).hexdigest() != attachment["sha256"]:
+            issues.append("attachment_hash_mismatch:" + attachment["path"])
+    if not steps:
+        steps = [Step(step_id=1, source="system", message="Episode failed before any captured model request.")]
+    metrics = [step.metrics for step in steps if step.metrics]
+    return Trajectory(
+        session_id=start["session_id"],
+        trajectory_id="holmes:" + start["session_id"],
+        agent=Agent(name="holmes", version=start["agent_version"], model_name=start["model"], tool_definitions=tools),
+        steps=steps,
+        final_metrics=FinalMetrics(
+            total_prompt_tokens=sum(m.prompt_tokens or 0 for m in metrics) if metrics else None,
+            total_completion_tokens=sum(m.completion_tokens or 0 for m in metrics) if metrics else None,
+            total_cached_tokens=sum(m.cached_tokens or 0 for m in metrics) if metrics else None,
+            total_steps=len(steps),
+        ),
+        extra={
+            "holmes": {
+                "raw_sha256": hashlib.sha256(raw).hexdigest(),
+                "raw_file": path.name,
+                "capture_complete": not issues,
+                "capture_issues": issues,
+                "attachments": attachments or [],
+                "episode_state": episode_end.get("state") if episode_end else "interrupted",
+            }
+        },
+    )
