diff --git a/tests/core/test_episode_trace.py b/tests/core/test_episode_trace.py
new file mode 100644
index 00000000..b56bbd98
--- /dev/null
+++ b/tests/core/test_episode_trace.py
@@ -0,0 +1,70 @@
+import json
+
+import pytest
+
+from holmes.core.episode_trace import recorded_completion, trace_event
+
+
+class Response:
+    def model_dump(self, **kwargs):
+        return {"choices": [{"message": {"content": "ok"}}]}
+
+
+def test_capture_effective_inputs_before_mutation(tmp_path, monkeypatch):
+    path = tmp_path / "events.jsonl"
+    monkeypatch.setenv("HOLMES_EPISODE_TRACE", str(path))
+    messages = [{"role": "system", "content": "compressed evidence only"}]
+    response = Response()
+    assert (
+        recorded_completion(
+            lambda **kw: response, model="test", messages=messages, tools=[]
+        )
+        is response
+    )
+    messages[0]["content"] = "later evidence must not leak backwards"
+    events = [json.loads(line) for line in path.read_text().splitlines()]
+    assert events[0]["request"]["messages"][0]["content"] == "compressed evidence only"
+    assert events[0]["request_id"] == events[1]["request_id"]
+
+
+def test_disabled_has_no_capture_side_effects(tmp_path, monkeypatch):
+    monkeypatch.delenv("HOLMES_EPISODE_TRACE", raising=False)
+    expected = Response()
+    assert recorded_completion(lambda **kw: expected, messages=[]) is expected
+    assert not list(tmp_path.iterdir())
+
+
+def test_credentials_not_recorded(tmp_path, monkeypatch):
+    path = tmp_path / "events.jsonl"
+    monkeypatch.setenv("HOLMES_EPISODE_TRACE", str(path))
+    monkeypatch.setenv("OPENAI_API_KEY", "test-private-api-key")
+    recorded_completion(
+        lambda **kw: Response(),
+        model="test",
+        messages=[{"role": "user", "content": "test-private-api-key"}],
+        api_key="test-private-api-key",
+        extra_headers={"Authorization": "secret"},
+    )
+    assert "test-private-api-key" not in path.read_text()
+    assert "Authorization" not in path.read_text()
+
+
+def test_model_error_retains_request(tmp_path, monkeypatch):
+    path = tmp_path / "events.jsonl"
+    monkeypatch.setenv("HOLMES_EPISODE_TRACE", str(path))
+
+    def fail(**kwargs):
+        raise TimeoutError("provider timeout")
+
+    with pytest.raises(TimeoutError):
+        recorded_completion(fail, model="test", messages=[])
+    events = [json.loads(line) for line in path.read_text().splitlines()]
+    assert [event["event"] for event in events] == ["model_request", "model_error"]
+
+
+def test_redaction_preserves_disk_component_names(tmp_path, monkeypatch):
+    path = tmp_path / "events.jsonl"
+    monkeypatch.setenv("HOLMES_EPISODE_TRACE", str(path))
+    trace_event("tool_end", output="openebs/node-disk-manager sk-1234567890abcdef1234567890abcdef")
+    output = json.loads(path.read_text())["output"]
+    assert output == "openebs/node-disk-manager [REDACTED]"
