+from contextlib import asynccontextmanager
+from unittest.mock import AsyncMock
+
+import pytest
+from mcp.types import CallToolResult, TextContent, Tool
+
+from holmes.core.tools import StructuredToolResultStatus
+from holmes.plugins.toolsets.mcp import toolset_mcp
+from holmes.plugins.toolsets.mcp.toolset_mcp import MCPConfig, RemoteMCPTool, RemoteMCPToolset
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("enabled,text,failed", [
+    (False, "Command Rejected: forbidden", False),
+    (True, "Command Rejected: forbidden", True),
+    (True, "Command Rejected (ValueError): Pipe commands are forbidden", True),
+    (True, "Application log: Command Rejected: forbidden", False),
+    (True, "pod1 Running", False),
+])
+async def test_scoped_recovery_preserves_payload(monkeypatch, enabled, text, failed):
+    config = {"url": "http://localhost:1234/sse"}
+    if enabled:
+        config["content_error_rules"] = [{"prefix": "Command Rejected", "category": "rejected", "recovery_hint": "Use allowed queries."}]
+    toolset = RemoteMCPToolset(name="test", description="test", config=config)
+    toolset._mcp_config = MCPConfig(**config)
+    tool = RemoteMCPTool.create(Tool(name="query", inputSchema={"type": "object", "properties": {}}), toolset)
+    session = AsyncMock()
+    session.call_tool.return_value = CallToolResult(content=[TextContent(type="text", text=text)], isError=False)
+
+    @asynccontextmanager
+    async def connected(*args):
+        yield session
+
+    monkeypatch.setattr(toolset_mcp, "get_initialized_mcp_session", connected)
+    result = await tool._invoke_async({}, None)
+    assert result.data == text
+    assert result.status == (StructuredToolResultStatus.ERROR if failed else StructuredToolResultStatus.SUCCESS)
+    assert bool(result.error) == failed
+    session.call_tool.assert_awaited_once()
