index 00000000..664b1a9b
--- /dev/null
+++ b/tests/core/test_diagnosis_review.py
@@ -0,0 +1,86 @@
+import json
+import threading
+from unittest.mock import patch
+
+import pytest
+
+from holmes.core.diagnosis_review import REVIEW_PROMPT
+from holmes.core.tool_calling_llm import LLMInterruptedError
+from tests.test_tool_calling_llm import (
+    LIMIT_PATCH,
+    _make_context_limiter_passthrough,
+    _make_llm_response,
+    _make_mock_tool_call,
+    _make_tool_call_result,
+    make_ai,
+    mock_llm,
+    mock_tool_executor,
+)
+
+
+def response(text="diagnosis", finish="stop", tools=None):
+    value = _make_llm_response(content=text, tool_calls=tools)
+    value.choices[0].finish_reason = finish
+    return value
+
+
+@pytest.mark.parametrize("enabled,calls", [(False, 1), (True, 2)])
+@patch(LIMIT_PATCH, side_effect=_make_context_limiter_passthrough)
+def test_review_is_opt_in_and_once(_limit, make_ai, mock_llm, enabled, calls):
+    ai = make_ai()
+    ai.diagnosis_review = enabled
+    mock_llm.completion.side_effect = [response("draft"), response("verified")]
+    result = ai.call([{"role": "user", "content": "diagnose"}])
+    assert result.num_llm_calls == calls
+    assert result.result == ("verified" if enabled else "draft")
+    if enabled:
+        messages = mock_llm.completion.call_args.kwargs["messages"]
+        assert sum(m.get("content") == REVIEW_PROMPT for m in messages) == 1
+        assert {"role": "assistant", "content": "draft"} in messages
+
+
+@pytest.mark.parametrize("steps,finish", [(1, "stop"), (3, "length"), (3, "content_filter")])
+@patch(LIMIT_PATCH, side_effect=_make_context_limiter_passthrough)
+def test_review_respects_finish_and_budget(_limit, make_ai, mock_llm, steps, finish):
+    ai = make_ai(max_steps=steps)
+    ai.diagnosis_review = True
+    mock_llm.completion.return_value = response(finish=finish)
+    result = ai.call([{"role": "user", "content": "diagnose"}])
+    assert result.num_llm_calls == 1
+
+
+@patch(LIMIT_PATCH, side_effect=_make_context_limiter_passthrough)
+def test_review_can_investigate_and_uses_same_budget(_limit, make_ai, mock_llm):
+    ai = make_ai(max_steps=3)
+    ai.diagnosis_review = True
+    mock_llm.completion.side_effect = [response("draft"), response(tools=[_make_mock_tool_call()]), response("corrected")]
+    ai._invoke_llm_tool_call = lambda *a, **kw: _make_tool_call_result()
+    result = ai.call([{"role": "user", "content": "diagnose"}])
+    assert result.num_llm_calls == 3
+    assert result.result == "corrected"
+    assert mock_llm.completion.call_args.kwargs["tools"] is None
+
+
+@patch(LIMIT_PATCH, side_effect=_make_context_limiter_passthrough)
+def test_review_does_not_swallow_model_error(_limit, make_ai, mock_llm, monkeypatch, tmp_path):
+    path = tmp_path / "events.jsonl"
+    monkeypatch.setenv("HOLMES_EPISODE_TRACE", str(path))
+    ai = make_ai()
+    ai.diagnosis_review = True
+    mock_llm.completion.side_effect = TimeoutError("model")
+    with pytest.raises(TimeoutError):
+        ai.call([{"role": "user", "content": "diagnose"}])
+    assert "model_error" in path.read_text()
+
+
+def test_cancelled_loop_does_not_call_model(make_ai, mock_llm, monkeypatch, tmp_path):
+    path = tmp_path / "events.jsonl"
+    monkeypatch.setenv("HOLMES_EPISODE_TRACE", str(path))
+    ai = make_ai()
+    ai.diagnosis_review = True
+    cancel = threading.Event()
+    cancel.set()
+    with pytest.raises(LLMInterruptedError):
+        list(ai.call_stream(msgs=[{"role": "user", "content": "diagnose"}], cancel_event=cancel))
+    mock_llm.completion.assert_not_called()
+    assert json.loads(path.read_text())["reason"] == "cancelled"
