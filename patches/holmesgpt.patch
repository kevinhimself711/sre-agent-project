@@ -0,0 +1,125 @@
+"""Opt-in, local JSONL capture at the effective model/tool boundaries.
+
+Disabled unless HOLMES_EPISODE_TRACE is set. No credentials or headers are
+serialized. Requests are copied at write time, before caller history mutates.
+"""
+
+from __future__ import annotations
+
+import inspect
+import json
+import os
+import re
+import threading
+import time
+import uuid
+from datetime import datetime, timezone
+from pathlib import Path
+
+_lock = threading.Lock()
+
+
+def _json_default(value):
+    if hasattr(value, "model_dump"):
+        return value.model_dump(mode="json")
+    if hasattr(value, "value"):
+        return value.value
+    return str(value)
+
+
+def trace_event(event: str, **data):
+    destination = os.environ.get("HOLMES_EPISODE_TRACE")
+    if not destination:
+        return
+    payload = {
+        "schema_version": 1,
+        "event": event,
+        "timestamp": datetime.now(timezone.utc).isoformat(),
+        **data,
+    }
+    text = json.dumps(payload, ensure_ascii=False, default=_json_default)
+    for name, secret in os.environ.items():
+        if len(secret) >= 8 and any(
+            term in name.upper() for term in ("API_KEY", "PASSWORD", "AUTH_TOKEN")
+        ):
+            text = text.replace(secret, "[REDACTED]")
+    text = re.sub(r"\bsk-[A-Za-z0-9_-]{16,}", "[REDACTED]", text)
+    path = Path(destination)
+    with _lock:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        with path.open("a", encoding="utf-8") as handle:
+            handle.write(text + "\n")
+            handle.flush()
+
+
+def recorded_completion(completion, **kwargs):
+    if not os.environ.get("HOLMES_EPISODE_TRACE"):
+        return completion(**kwargs)
+    request_id = uuid.uuid4().hex
+    purpose = "investigation"
+    frame = inspect.currentframe()
+    try:
+        while frame:
+            module = frame.f_globals.get("__name__", "")
+            if module.endswith("truncation.compaction"):
+                purpose = "compaction"
+                break
+            if module.endswith("transformers.llm_summarize"):
+                purpose = "tool_summary"
+                break
+            frame = frame.f_back
+    finally:
+        del frame
+    allowed = (
+        "model",
+        "messages",
+        "tools",
+        "tool_choice",
+        "temperature",
+        "top_p",
+        "max_tokens",
+        "max_completion_tokens",
+        "response_format",
+        "stream",
+        "reasoning_effort",
+        "enable_thinking",
+        "extra_body",
+    )
+    # extra_body is filtered as well: providers may accept authentication there.
+    request = {key: value for key, value in kwargs.items() if key in allowed}
+    if isinstance(request.get("extra_body"), dict):
+        request["extra_body"] = {
+            k: v
+            for k, v in request["extra_body"].items()
+            if k in ("enable_thinking", "thinking_budget")
+        }
+    trace_event(
+        "model_request", request_id=request_id, purpose=purpose, request=request
+    )
+    start = time.monotonic()
+    try:
+        response = completion(**kwargs)
+    except BaseException as exc:
+        trace_event(
+            "model_error",
+            request_id=request_id,
+            error_type=type(exc).__name__,
+            elapsed_seconds=time.monotonic() - start,
+        )
+        raise
+    if hasattr(response, "model_dump"):
+        trace_event(
+            "model_response",
+            request_id=request_id,
+            response=response.model_dump(mode="json"),
+            elapsed_seconds=time.monotonic() - start,
+        )
+    else:
+        # Capture is explicitly incomplete for streaming; never label it training-ready.
+        trace_event(
+            "model_capture_incomplete",
+            request_id=request_id,
+            reason="streaming_or_unknown_response",
+            elapsed_seconds=time.monotonic() - start,
+        )
+    return response
