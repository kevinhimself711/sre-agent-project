@@ -0,0 +1,22 @@
+"""A bounded, opt-in check of evidence before accepting a diagnosis."""
+
+REVIEW_PROMPT = (
+    "Before submitting this draft, review the evidence once. "
+    "Check whether the reported symptom is still present and whether the timestamps "
+    "support the proposed cause rather than a recovered startup error. "
+    "Identify an observation that could contradict your leading explanation; use the "
+    "available read-only tools to check a material gap if the remaining budget allows. "
+    "Do not invent evidence or assume that all errors are relevant. "
+    "Then provide your final diagnosis, distinguishing verified facts from uncertainty. "
+    "You may keep the draft's conclusion if it is supported."
+)
+
+
+def review_decision(finish_reason, content, iteration, max_steps):
+    if finish_reason != "stop":
+        return "non_stop_finish"
+    if not isinstance(content, str) or not content.strip():
+        return "empty_answer"
+    if iteration >= max_steps:
+        return "budget_exhausted"
+    return "triggered"
