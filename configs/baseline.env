# Non-secret configuration. API keys are injected at runtime.
export SRE_PROJECT_ROOT="${SRE_PROJECT_ROOT:-$HOME/sre-agent-project}"
export SRE_TOOL_ROOT="${SRE_TOOL_ROOT:-$HOME/sre-agent-project}"
export AGENT_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
export JUDGE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
export OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
export OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
export AGENT_MODEL_ID=openai/qwen3.8-max
export JUDGE_MODEL_ID=openai/qwen3.8-max
export MODEL=openai/qwen3.8-max
export CLASSIFIER_MODEL=openai/qwen3.8-max
export OVERRIDE_MAX_OUTPUT_TOKEN=8192
export LLM_QUERY_MAX_RETRIES=2
export LLM_EXTRA_BODY_JSON='{"enable_thinking":false}'
export CLASSIFIER_EXTRA_BODY_JSON='{"enable_thinking":false}'
export LLM_REQUEST_TIMEOUT=120
export SREGYM_SOCIAL_SOURCE_REV=6ecb09706140f8730b5385c08f1386c654c3c526
export KUBECONFIG="${SREGYM_ADMIN_KUBECONFIG:-$SRE_TOOL_ROOT/configs/kubeconfig}"
export SREGYM_ADMIN_KUBECONFIG="$KUBECONFIG"
export SREGYM_CACHE_DIR="$SRE_TOOL_ROOT/cache/sre-agent-dev"
export API_PORT=18000
export MCP_SERVER_PORT=19954
export K8S_PROXY_PORT=17443
export PATH="$SRE_TOOL_ROOT/bin:$SRE_TOOL_ROOT/tools-venv/bin:$PATH"
